{
  "name": "superposition-academy",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "vitest run",
    "check:content": "node scripts/check-content.mjs",
    "fix:frontmatter": "node scripts/fix-frontmatter.mjs",
    "assets": "node -e \"console.log('OG 图与图标需要 Python + Pillow：python scripts/make_assets.py')\"",
    "verify": "npm run check:content && npm test && npm run build",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0",
    "katex": "^0.19.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1",
    "yaml": "^2.9.1"
  }
}
