---
interface Props {
  kind: string;
  caption?: string;
  label?: string;
  props?: Record<string, unknown>;
}
const { kind, caption, label = '交互演示', props = {} } = Astro.props;
---

<figure class="demo" data-demo={kind} data-props={JSON.stringify(props)}>
  <div class="demo-head">
    <span class="demo-label"><span class="demo-dot"></span>{label}</span>
    <div class="demo-actions">
      <button class="icon-btn" type="button" data-replay aria-label="重播演示">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M3 12a9 9 0 1 0 3.2-6.9" stroke-linecap="round"></path>
          <path d="M3 4.5V10h5.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        重播
      </button>
    </div>
  </div>
  <div class="demo-body"></div>
  {caption && <figcaption class="demo-foot">{caption}</figcaption>}
</figure>
