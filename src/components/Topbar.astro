---
interface Props {
  path?: string;
}
const { path = '' } = Astro.props;
const links = [
  { href: '/learn', label: '课程' },
  { href: '/roadmap', label: '路线' },
  { href: '/lab', label: '实验室' },
  { href: '/exam', label: '自测' },
  { href: '/glossary', label: '术语' },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="topbar">
  <button
    class="icon-only menu-btn"
    id="menuBtn"
    aria-label="打开目录"
    aria-controls="sidebar"
    aria-expanded="false"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
    </svg>
  </button>

  <a class="brand" href="/" aria-label="叠加学堂首页">
    <svg class="brand-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <circle cx="16" cy="16" r="12.4" stroke="currentColor" stroke-width="1.5" opacity=".28"></circle>
      <ellipse
        cx="16"
        cy="16"
        rx="12.4"
        ry="5.1"
        stroke="currentColor"
        stroke-width="1.5"
        transform="rotate(-32 16 16)"
        opacity=".55"></ellipse>
      <circle cx="16" cy="16" r="3.1" fill="currentColor"></circle>
    </svg>
    <span>叠加学堂</span>
    <span class="brand-latin">superposition</span>
  </a>

  <nav class="topnav" aria-label="主导航">
    {
      links.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>

  <div class="topbar-right">
    <button class="search-btn" id="searchBtn" aria-label="搜索课程">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.6-3.6" stroke-linecap="round"></path>
      </svg>
      <span class="label">搜索课程</span>
      <kbd>⌘K</kbd>
    </button>

    <button class="icon-only" id="themeBtn" aria-label="切换深色模式" title="切换深浅色">
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2"></circle>
        <path d="M12 2.6v2.2M12 19.2v2.2M4.4 12H2.2M21.8 12h-2.2M5.9 5.9 4.4 4.4M19.6 19.6l-1.5-1.5M18.1 5.9l1.5-1.5M4.4 19.6l1.5-1.5" stroke-linecap="round"></path>
      </svg>
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M20.5 14.3A8.6 8.6 0 0 1 9.7 3.5a8.6 8.6 0 1 0 10.8 10.8Z" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  import '../scripts/theme';
</script>
